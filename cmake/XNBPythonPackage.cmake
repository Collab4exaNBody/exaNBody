#
# xnb_add_python_package : build and install a Python package for an exaNBody
# based application, on top of pyonika (and pyexanbody).
#
#   xnb_add_python_package( NAME <pkg>
#                           PACKAGE_DIR <dir containing the .py files of <pkg>>
#                           [EXTENSION <module> SOURCES <cpp...>]
#                           [LINK_LIBRARIES <libs...>]
#                           [INCLUDE_DIRECTORIES <dirs...>]
#                           [COMPILE_DEFINITIONS <defs...>]
#                           [DEPENDENCIES <pip requirements...>]
#                           [EXTRA_PACKAGES <dirs of pure Python packages...>]
#                           [EXTRA_NAME <name> EXTRA_DEPENDENCIES <pip requirements...>]
#                           [SCRIPTS <command=module:function...>]
#                           [VERSION <version>] [DESCRIPTION <text>] )
#
# Layout, identical in the build tree (${PROJECT_BINARY_DIR}/python) and in the
# install tree (<prefix>/python):
#   <pkg>/*.py, <pkg>/<module>.<abi>.so, <pkg>/_paths.py, pyproject.toml
#   <extra>/*.py, <extra>/*.yaml for each of EXTRA_PACKAGES
# EXTRA_DEPENDENCIES are installed with 'pip install <prefix>/python[<name>]'.
# so that 'pip install <prefix>/python' installs the package in a virtualenv.
# _paths.py defines ONIKA_INSTALL_DIR, XNB_INSTALL_DIR and APP_INSTALL_DIR.

function(xnb_add_python_package)
  cmake_parse_arguments(PKG "" "NAME;PACKAGE_DIR;EXTENSION;VERSION;DESCRIPTION;EXTRA_NAME"
                        "SOURCES;LINK_LIBRARIES;INCLUDE_DIRECTORIES;COMPILE_DEFINITIONS;DEPENDENCIES;EXTRA_PACKAGES;EXTRA_DEPENDENCIES;SCRIPTS" ${ARGN})
  if(NOT PKG_VERSION)
    set(PKG_VERSION ${PROJECT_VERSION})
  endif()
  if(NOT PKG_VERSION)
    set(PKG_VERSION 0.0.0)
  endif()

  find_package(Python3 REQUIRED COMPONENTS Interpreter Development.Module)
  find_package(pybind11 QUIET)
  if(NOT pybind11_FOUND)
    include(FetchContent)
    FetchContent_Declare(pybind11 GIT_REPOSITORY https://github.com/pybind/pybind11 GIT_TAG v2.13.6)
    FetchContent_MakeAvailable(pybind11)
  endif()

  set(build_root ${PROJECT_BINARY_DIR}/python)
  file(MAKE_DIRECTORY ${build_root}/${PKG_NAME})

  if(PKG_EXTENSION)
    pybind11_add_module(${PKG_EXTENSION} ${PKG_SOURCES})
    target_include_directories(${PKG_EXTENSION} PRIVATE ${ONIKA_INCLUDE_DIRS} ${PKG_INCLUDE_DIRECTORIES})
    # make onika::math types (Vec3d, IJK, ...) and logging available in namespace exanb, as for plugins
    target_compile_definitions(${PKG_EXTENSION} PRIVATE
      ONIKA_MATH_EXPORT_NAMESPACE=exanb ONIKA_SCG_EXPORT_NAMESPACE=exanb ONIKA_LOG_EXPORT_NAMESPACE=exanb
      ${ONIKA_COMPILE_DEFINITIONS} ${PKG_COMPILE_DEFINITIONS})
    target_link_libraries(${PKG_EXTENSION} PRIVATE ${PKG_LINK_LIBRARIES})
    set_target_properties(${PKG_EXTENSION} PROPERTIES
      CXX_STANDARD 20
      LIBRARY_OUTPUT_DIRECTORY ${build_root}/${PKG_NAME}
      INSTALL_RPATH "${CMAKE_INSTALL_PREFIX}/lib;${XNB_ROOT_DIR}/lib;${onika_DIR}/lib")
    install(TARGETS ${PKG_EXTENSION} DESTINATION python/${PKG_NAME})
  endif()

  # pure Python sources
  file(GLOB py_sources ${PKG_PACKAGE_DIR}/*.py)
  foreach(f ${py_sources})
    configure_file(${f} ${build_root}/${PKG_NAME}/ COPYONLY)
  endforeach()
  install(FILES ${py_sources} DESTINATION python/${PKG_NAME})

  # additional pure Python packages shipped with the main one
  set(packages "\"${PKG_NAME}\"")
  set(package_data "${PKG_NAME} = [\"*.so\", \"*.pyd\"]\n")
  foreach(dir ${PKG_EXTRA_PACKAGES})
    get_filename_component(extra ${dir} NAME)
    file(GLOB extra_sources ${dir}/*.py ${dir}/*.yaml)
    file(MAKE_DIRECTORY ${build_root}/${extra})
    foreach(f ${extra_sources})
      configure_file(${f} ${build_root}/${extra}/ COPYONLY)
    endforeach()
    install(FILES ${extra_sources} DESTINATION python/${extra})
    string(APPEND packages ", \"${extra}\"")
    string(APPEND package_data "${extra} = [\"*.yaml\"]\n")
  endforeach()

  # baked install locations
  file(WRITE ${build_root}/${PKG_NAME}/_paths.py
    "# Generated by CMake -- do not edit.\n"
    "ONIKA_INSTALL_DIR = \"${onika_DIR}\"\n"
    "XNB_INSTALL_DIR = \"${XNB_ROOT_DIR}\"\n"
    "APP_INSTALL_DIR = \"${CMAKE_INSTALL_PREFIX}\"\n")
  install(FILES ${build_root}/${PKG_NAME}/_paths.py DESTINATION python/${PKG_NAME})

  # pip metadata
  set(deps "\"numpy\"")
  foreach(d ${PKG_DEPENDENCIES})
    string(APPEND deps ", \"${d}\"")
  endforeach()
  set(optional "")
  if(PKG_EXTRA_NAME)
    set(extra_deps "")
    foreach(d ${PKG_EXTRA_DEPENDENCIES})
      if(extra_deps)
        string(APPEND extra_deps ", ")
      endif()
      string(APPEND extra_deps "\"${d}\"")
    endforeach()
    set(optional "\n[project.optional-dependencies]\n${PKG_EXTRA_NAME} = [${extra_deps}]\n")
  endif()
  set(scripts "")
  if(PKG_SCRIPTS)
    set(scripts "\n[project.scripts]\n")
    foreach(s ${PKG_SCRIPTS})
      string(REPLACE "=" ";" s_parts "${s}")
      list(GET s_parts 0 s_name)
      list(GET s_parts 1 s_target)
      string(APPEND scripts "${s_name} = \"${s_target}\"\n")
    endforeach()
  endif()
  file(WRITE ${build_root}/pyproject.toml
    "# Generated by CMake -- do not edit.\n"
    "# pip install ${CMAKE_INSTALL_PREFIX}/python\n"
    "[build-system]\nrequires = [\"setuptools>=64\"]\nbuild-backend = \"setuptools.build_meta\"\n\n"
    "[project]\nname = \"${PKG_NAME}\"\nversion = \"${PKG_VERSION}\"\n"
    "description = \"${PKG_DESCRIPTION}\"\n"
    "requires-python = \"==${Python3_VERSION_MAJOR}.${Python3_VERSION_MINOR}.*\"\n"
    "dependencies = [${deps}]\n"
    "${optional}${scripts}\n"
    "[tool.setuptools]\npackages = [${packages}]\n\n"
    "[tool.setuptools.package-data]\n${package_data}")
  install(FILES ${build_root}/pyproject.toml DESTINATION python)
endfunction()
